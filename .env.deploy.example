# Settings for scripts/deploy.sh. Copy this file to .env.deploy (which is
# gitignored) and fill it in. These are kept apart from .env on purpose: .env
# is handed to the container as its runtime environment, and a Home Assistant
# token and a Docker endpoint have no business being in there.
#
# Every key can also be given as an environment variable, and the environment
# wins over the file. Values are taken literally except for one optional layer
# of surrounding quotes, so there is no inline-comment syntax: keep comments on
# their own line.

# Base URL of your Home Assistant, for example http://homeassistant.local:8123
HA_URL=
# A long-lived access token, created at the bottom of your Home Assistant profile page.
HA_TOKEN=

# Which Docker daemon to deploy to, by context name; "default" means the local one.
DOCKER_CONTEXT=
# Which Docker daemon to deploy to, by endpoint, for example ssh://pi@192.0.2.10. Set this or DOCKER_CONTEXT, not both.
DOCKER_HOST=

# A Docker Engine API over plain HTTP, for example http://192.0.2.10:2376. Use
# this for a daemon the CLI cannot be pointed at, typically because it sits
# behind a proxy that wants a header of its own. The image is then built on this
# machine, exported with docker save, and POSTed to the target's /images/load;
# the target never builds anything. Mutually exclusive with DOCKER_CONTEXT and
# DOCKER_HOST, and it needs DEPLOY_CMD, because a loaded image still has to be
# started by someone.
DOCKER_API_URL=
# One header added to every call to DOCKER_API_URL, written as "Name: value".
# Usually the credential, which is why this file is not tracked. Empty means none.
DOCKER_API_HEADER=
# Seconds to wait for a single Docker API call. The image upload is one call, so
# do not make this small. Empty means 600.
DOCKER_API_TIMEOUT=

# Command that starts the service, replacing `docker compose up -d`. For a stack
# owned by something other than this checkout: a deploy API, an Ansible run, an
# ssh command. It is run with IMAGE, TAG and SERVICE in its environment, and a
# non-zero exit stops the deploy. Empty means use compose, as before.
DEPLOY_CMD=

# Image name to build and run; the script tags it with the version and with latest. Empty means hafele2mqtt.
IMAGE=
# Compose file to use, relative to the repo root. Empty means compose.yaml.
COMPOSE_FILE=
# Service inside that compose file to restart; the rest of the stack is left alone. Empty means hafele2mqtt.
SERVICE=
# Architecture to build for, for example linux/arm64. Empty means whatever the Docker target builds natively.
PLATFORM=

# Seconds to wait for a single Home Assistant HTTP call. Empty means 15.
HA_TIMEOUT=
