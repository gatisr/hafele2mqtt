# Copy to .env. .env is gitignored.
#
# Only the three MQTT_* lines below are required. Everything under "optional"
# already has a working default or is derived from the .connect file; leave
# those commented out unless you have a reason to change them.

# ============================================================================
# REQUIRED
# ============================================================================
MQTT_HOST=mqtt.example.lan
MQTT_USER=changeme
MQTT_PASS=changeme

# (plus your Hafele Connect export dropped into ./config/ - any *.connect name)

# ============================================================================
# OPTIONAL - shown with their defaults
# ============================================================================

# --- MQTT ---
# 1-65535.
#MQTT_PORT=1883
#MQTT_CLIENT_ID=hafele2mqtt
# Longest wait between reconnection attempts, in seconds. Deliberately not the
# same knob as BLE_RETRY_MAX: a broker that went away for a restart should be
# picked up again promptly, whatever the Bluetooth backoff is set to.
#MQTT_RECONNECT_MAX=60
# Topic prefix for commands and state. Changing it moves the topics; the bridge
# clears the retained payloads under the old prefix by itself.
#BASE_TOPIC=hafele
# Home Assistant discovery prefix. Changing this DOES orphan the old entities:
# run --purge-discovery with the old value first. See the README.
#DISCOVERY_PREFIX=homeassistant

# --- MQTT over TLS (off by default) ---
# Off means the password and every light state cross the network in the clear,
# which is fine on a LAN you trust and not fine anywhere else. Turning this on
# normally means MQTT_PORT=8883 as well; the bridge warns if it is still 1883.
#MQTT_TLS=false
# CA certificate that signed the broker's certificate, as the container sees it
# (mount it in, e.g. `- ./ca.crt:/config/ca.crt:ro`). Empty = the system trust
# store, which is what a publicly-signed broker certificate needs.
#MQTT_TLS_CA=
# Skips the check that the broker's certificate matches MQTT_HOST. It does NOT
# skip verifying the signature, so a self-signed certificate still has to be
# named in MQTT_TLS_CA. Only for a certificate whose name you cannot fix: with
# this on, anything holding that certificate can impersonate your broker.
#MQTT_TLS_INSECURE=false

# --- Incoming command limits ---
# A bound on what anything publishing to the broker can spend, not a policy for
# normal use: both defaults sit far above what Home Assistant produces, and
# repeated commands for one entity are collapsed into the latest rather than
# queued. See the README before lowering either.
# Commands per second, sustained. Must be above 0.
#CMD_RATE_LIMIT=10
# Commands held at once, and also the burst allowed from idle, so a scene
# switching this many lights at once goes out at full speed. Must be at least 1.
#CMD_QUEUE_MAX=64

# --- Mesh file: four ways to hand it over, in this priority order ---
# 1. An explicit path. Needed only if /config holds more than one export.
#MESH_FILE=
# 2. The directory searched for a single *.connect file.
#MESH_DIR=/config
# 3. The file contents inline, for secret managers that inject strings.
#MESH_JSON=
# 4. The same, base64-encoded (Dockhand, Portainer, Kubernetes secrets).
#MESH_JSON_BASE64=

# --- Naming overrides (entirely optional) ---
# Renames entities, pins their ids and hides the ones you do not want. Empty
# means "use <MESH_DIR>/entities.yaml if there is one", so you normally just
# drop the file in and leave this alone. A path set here that does not exist
# is an error, not a fallback: starting anyway would publish every entity
# under the names you were trying to replace. See the README.
#ENTITIES_FILE=

# --- Bluetooth Mesh ---
# Unicast address the bridge *starts* from. Empty = derived from the export
# (provisioner address + 1, skipping everything a real node occupies). Set it
# only if you know the address is free: a collision breaks both parties
# silently, because mesh replay protection is per source address. The bridge
# moves off this address by itself once its 24-bit counter runs low, and will
# not come back to it afterwards even if this value still names it.
#SRC_ADDR=
# Mesh IV index. Empty = read from the state file and raised by secure network
# beacons heard on air. A wrong IV index makes every node discard our messages
# without a word, so this value is a floor, never a cap: it is never lowered.
# 0-4294967295.
#IV_INDEX=
# TTL on outgoing access messages (how many relay hops are allowed). 0-127, and
# both 0 and 1 mean "do not relay this", so only nodes within direct radio range
# of the proxy act on a command. The default suits a network that fits in one
# room with a hop or two of slack; raise it if distant lights do not respond.
#TTL=5
# Seconds between Light Lightness Get polls. 0 disables polling entirely,
# including the start-up poll that is the only thing giving an entity a state
# after a restart, so expect blank cards in Home Assistant until a light moves.
#POLL_INTERVAL=30
# How many sequence numbers to reserve on disk at a time. Lower = more writes,
# higher = more numbers skipped after an unclean shutdown. Both are harmless.
#SEQ_BLOCK=500
# How many numbers to skip when the state file is gone but the state directory
# is not empty, i.e. the counter was lost rather than never started. Too low
# and the nodes ignore the bridge until it catches up; see the README.
#SEQ_RECOVERY_JUMP=100000
# Move to a fresh unicast address when the current one has a million of its
# 16.7 million sequence numbers left, instead of warning and later stopping.
# Each move costs every node one entry in its replay list, so do not lower the
# threshold in the source to watch it happen; see the README.
#SEQ_AUTO_ROTATE=true

# --- Bluetooth adapter ---
# Pin one GATT Proxy node by BLE address, e.g. AA:BB:CC:DD:EE:FF.
# Empty = discover by network ID and take the strongest signal.
#PROXY_ADDRESS=
# Pin a specific Bluetooth adapter if the host has several. Takes either an
# `hciN` name or the adapter's own MAC address, e.g. AA:BB:CC:DD:EE:FF. Prefer
# the MAC: `hciN` is assigned in the order the kernel happens to find the
# radios, so a reboot, a re-plugged dongle or a firmware load that takes a
# moment longer can move the name onto a different piece of hardware, and the
# only symptom is a bridge that hears nothing.
# Empty, or naming an adapter that is not there, is not fatal: the bridge then
# scans with every adapter the host has and keeps the one that can actually see
# our network's proxy advertisement, strongest signal first. So leaving this
# unset is a reasonable choice on a host with more than one radio.
#BLE_ADAPTER=
# Seconds spent scanning for a proxy node. After repeated failures the bridge
# scans for three times this by itself before trying anything more drastic.
#BLE_SCAN_TIMEOUT=10
# Reconnect backoff bounds, in seconds. The floor must be above zero, or
# reconnecting becomes a busy loop against a radio that is not coming back.
#BLE_RETRY_MIN=2
#BLE_RETRY_MAX=120

# --- Paths ---
# Must be on a writable volume: it holds the mesh sequence number.
#STATE_FILE=/data/state.json

# --- Healthcheck ---
# The bridge touches this on every turn of its poll loop and the container's
# HEALTHCHECK reads its age. It is a timestamp, not state, so it belongs on a
# tmpfs; nothing needs it to survive a restart. Set it empty to turn the
# healthcheck off.
#HEALTH_FILE=/tmp/health
# How old that timestamp may get before the container counts as unhealthy.
# 0 derives it from POLL_INTERVAL (three of them, and never under 180s), which
# is what you want unless you poll very rarely. Deliberately generous: a BLE
# reconnect must not turn the container red.
#HEALTH_MAX_AGE=0

# --- Display names ---
# The implicit "all nodes" group carries an internal name in the export rather
# than one you chose, so it gets this instead.
#ALL_GROUP_NAME=All lights
#SCENE_NAME_PREFIX=Scene

# --- Misc ---
# CRITICAL, ERROR, WARNING, INFO or DEBUG.
#LOG_LEVEL=INFO
